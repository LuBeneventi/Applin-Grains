{
  "info": {
    "_postman_id": "pedidos360-collection-v3",
    "name": "Pedidos360 - E2E Testing Suite (Via BFF)",
    "description": "Pruebas E2E completas consumiendo ÚNICAMENTE a través del BFF (Puerto 8088). Al crear la orden solo se envía { productoId, cantidad }, y el BFF resuelve precio y descripción desde Catálogo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Catálogo (A través de BFF)",
      "item": [
        {
          "name": "1.1 Crear Producto en Catálogo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Café Geisha Especial 250g\",\n  \"description\": \"Café de especialidad con notas florales y cítricas, tostado medio\",\n  \"price\": 14990,\n  \"stock\": 100,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1559056199-641a0ac8b55e?w=500\"\n}"
            },
            "url": {
              "raw": "{{bff_url}}/api/catalog/products",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "catalog",
                "products"
              ]
            },
            "description": "Pasa por el BFF (8088) y este redirige a ms-catalog (8086) creando el producto con ID 1."
          },
          "response": []
        },
        {
          "name": "1.2 Listar Productos de Catálogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/catalog/products",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "catalog",
                "products"
              ]
            },
            "description": "Consulta el catálogo a través del BFF."
          },
          "response": []
        },
        {
          "name": "1.3 Consultar Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/catalog/products/1",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "catalog",
                "products",
                "1"
              ]
            },
            "description": "Obtiene un producto específico a través del BFF."
          },
          "response": []
        },
        {
          "name": "1.4 Descontar Stock Manualmente",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/catalog/products/1/reduce-stock?quantity=2",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "catalog",
                "products",
                "1",
                "reduce-stock"
              ],
              "query": [
                {
                  "key": "quantity",
                  "value": "2"
                }
              ]
            },
            "description": "Reduce manualmente el stock del producto ID 1 a través del BFF en el Catálogo."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Órdenes (A través de BFF)",
      "item": [
        {
          "name": "2.1 Crear Pedido (Solo productoId y cantidad)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"CLI-5001\",\n  \"clienteNombre\": \"Luciano Morales\",\n  \"clienteEmail\": \"luciano@ejemplo.cl\",\n  \"clienteDireccion\": \"Av. Providencia 1234, Santiago\",\n  \"clienteRut\": \"18.345.678-9\",\n  \"items\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{bff_url}}/api/orders",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "El cliente solo envía productoId: 1 y cantidad: 2. El BFF consulta el Catálogo para obtener el precio real (14990) y nombre, ensambla la orden y la despacha a ms-orders de forma segura."
          },
          "response": []
        },
        {
          "name": "2.2 Consultar Pedido Simple por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/orders/1",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "orders",
                "1"
              ]
            },
            "description": "Proxy directo del BFF hacia ms-orders."
          },
          "response": []
        },
        {
          "name": "2.3 Consultar Pedido Enriquecido (BFF une Órdenes + Catálogo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/orders/1/enriched",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "orders",
                "1",
                "enriched"
              ]
            },
            "description": "EL NÚCLEO DEL BFF: El BFF consulta ms-orders para el pedido 1, toma cada productoId (1) y consulta ms-catalog para inyectar su nombre, descripción, stock e imageUrl."
          },
          "response": []
        },
        {
          "name": "2.4 Actualizar Estado Pedido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"EN_PREPARACION\"\n}"
            },
            "url": {
              "raw": "{{bff_url}}/api/orders/1/status",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "orders",
                "1",
                "status"
              ]
            },
            "description": "El BFF enruta la actualización a ms-orders y este emite evento de actualización por RabbitMQ."
          },
          "response": []
        },
        {
          "name": "2.5 Actualizar Estado a DESPACHADO (Notificación Real por Correo)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"DESPACHADO\"\n}"
            },
            "url": {
              "raw": "{{bff_url}}/api/orders/1/status",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "orders",
                "1",
                "status"
              ]
            },
            "description": "Actualiza el estado de la orden a DESPACHADO. Emite el evento a RabbitMQ (q.cmd.email con routing key email.send), el microservicio ms-notify lo consume y envía el correo real al cliente vía Gmail SMTP avisando que su pedido va en camino."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Auditoría (ms-audit a través de BFF)",
      "item": [
        {
          "name": "3.1 Timeline Cronológico de una Orden",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/audit/orders/{{order_id}}/timeline",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "audit",
                "orders",
                "{{order_id}}",
                "timeline"
              ]
            },
            "description": "Retorna la trazabilidad cronológica completa de la orden (quién, qué, cuándo, desde dónde, estado previo y posterior)."
          },
          "response": []
        },
        {
          "name": "3.2 Consultar Eventos con Filtros (Usuario, Fechas, Tipo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/audit/events?usuario=cliente@pedidos360.cl&eventType=OrderCreated",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "audit",
                "events"
              ],
              "query": [
                {
                  "key": "usuario",
                  "value": "cliente@pedidos360.cl"
                },
                {
                  "key": "eventType",
                  "value": "OrderCreated"
                },
                {
                  "key": "from",
                  "value": "2026-01-01T00:00:00",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-12-31T23:59:59",
                  "disabled": true
                }
              ]
            },
            "description": "Filtra eventos de auditoría por usuario, rango de fechas o tipo de evento."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Reportería y KPIs (ms-report a través de BFF)",
      "item": [
        {
          "name": "4.1 Resumen Global de KPIs en Tiempo Real",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/reports/summary",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "reports",
                "summary"
              ]
            },
            "description": "Devuelve métricas clave: total ventas, total pedidos, ticket promedio, pedidos entregados y lead time promedio."
          },
          "response": []
        },
        {
          "name": "4.2 Gráfico de Ventas (SalesChartComponent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/reports/sales-chart?from=2026-01-01T00:00:00&to=2026-12-31T23:59:59",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "reports",
                "sales-chart"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-01-01T00:00:00"
                },
                {
                  "key": "to",
                  "value": "2026-12-31T23:59:59"
                }
              ]
            },
            "description": "Ventas agregadas por día para renderizar en SalesChartComponent."
          },
          "response": []
        },
        {
          "name": "4.3 Gráfico de Tiempos de Ciclo / Lead Time (LeadTimeChartComponent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/reports/lead-time-chart",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "reports",
                "lead-time-chart"
              ]
            },
            "description": "Promedios de tiempo en minutos: preparación, despacho, entrega y ciclo total."
          },
          "response": []
        },
        {
          "name": "4.4 Gráfico de Productos Más Vendidos (TopProductsChartComponent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_url}}/api/reports/top-products-chart?limit=5",
              "host": [
                "{{bff_url}}"
              ],
              "path": [
                "api",
                "reports",
                "top-products-chart"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Top productos con mayor volumen y recaudación para TopProductsChartComponent."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "bff_url",
      "value": "http://localhost:8088"
    },
    {
      "key": "bearer_token",
      "value": "pega_aqui_tu_token_oauth2"
    }
  ]
}