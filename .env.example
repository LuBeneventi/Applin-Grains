# ==============================================================================
# CONFIGURACIÓN PARA DEPLOY EN AWS EC2 (Pedidos360)
# ==============================================================================

# ------------------------------------------------------------------------------
# Conexión a la instancia EC2 de RabbitMQ
# ------------------------------------------------------------------------------
# Si RabbitMQ corre en otra máquina EC2 dentro de la misma VPC/Subnet, usa su IP Privada:
RABBITMQ_HOST=172.31.X.X
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# Configuración de Correo Real (Gmail SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=tu_correo@gmail.com
# Contraseña de aplicación de 16 caracteres generada en Google (Cuenta -> Seguridad -> Contraseñas de aplicaciones)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=tu_correo@gmail.com
MAIL_SENDER_NAME=Pedidos360 Café

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Seguridad del BFF (Backend For Frontend)
# ------------------------------------------------------------------------------
# false: Pruebas rápidas en Postman sin token Bearer
# true: Producción con validación de tokens de Microsoft Entra ID
SECURITY_ENABLED=false
ENTRA_ISSUER_URI=https://login.microsoftonline.com/7787491b-efe4-4871-852a-79e07b048a5a/v2.0
ENTRA_API_CLIENT_ID=954079da-4c93-427f-9260-62b0e83029bf
